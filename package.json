{
  "name": "investa",
  "productName": "Investa",
  "version": "1.0.0",
  "description": "Investa — Aprenda, invista e evolua.",
  "main": "dist-electron/main.js",
  "author": "Bruno",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "electron:dev": "node scripts/build-electron.mjs && concurrently -k -n vite,app \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "smoke:data": "node scripts/build-electron.mjs && node dist-electron/smoke.js",
    "test:alerts": "node scripts/test-alerts.mjs",
    "test:groq": "node scripts/test-groq.mjs",
    "test:insight": "node scripts/test-insight.mjs",
    "test:shopping": "node scripts/test-shopping.mjs",
    "check:plan": "node scripts/check-plan.mjs",
    "icons": "node scripts/make-icons.mjs",
    "media": "npm run build && node scripts/capture.mjs",
    "android:sync": "vite build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:icons": "node scripts/make-android-icons.mjs"
  },
  "build": {
    "appId": "com.investa.app",
    "productName": "Investa",
    "copyright": "Copyright © 2026 Investa",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/main.js",
      "dist-electron/preload.js",
      "package.json"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Investa",
      "artifactName": "Investa-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Investa-Portatil-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Finance"
    }
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^4.5.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "electron": "^43.7.9",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "framer-motion": "^11.18.2",
    "jspdf": "^4.2.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.53.0",
    "playwright-core": "^1.64.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.6",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.4.21",
    "wait-on": "^7.2.0",
    "zustand": "^5.0.15"
  }
}
